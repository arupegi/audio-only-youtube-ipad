{
  "manifest_version": 3,
  "name": "Audio Only YouTube for iPad",
  "version": "0.9.0",
  "description": "YouTubeをiPad Safariで音声専用再生し、映像・PIP映像・シーク画像・関連サムネイル・ライブチャット等の通信を抑え、通信量の概算表示とCSV出力を行うWeb Extensionです。",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "activeTab",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://youtube.com/*",
    "*://youtu.be/*",
    "*://*.googlevideo.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Audio Only YouTube",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
